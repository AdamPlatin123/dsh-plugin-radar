 "domain_meta": [
  {
   "key": "webui",
   "title": "🔌 Web UI 增强",
   "desc": "界面与交互增强插件：侧边栏、输入框、皮肤主题、面板 dock、消息显示、状态栏与可视化，让 Web 界面更顺手更好看"
  },
  {
   "key": "agent",
   "title": "🤖 Agent 能力",
   "desc": "增强 agent 本身的能力：子代理管理、记忆与上下文、会话控制、规划执行、唤醒/睡眠、提示词与技能注入"
  },
  {
   "key": "coding",
   "title": "💻 编码开发",
   "desc": "面向编程场景的工具：代码操作、git 集成、终端、diff 与编辑器、文档生成、语言支持与构建辅助"
  },
  {
   "key": "comm",
   "title": "📡 消息通讯",
   "desc": "把 dsh 接入各类沟通渠道：微信/QQ/Telegram/飞书机器人、桌面通知、消息分享与跨端回复"
  },
  {
   "key": "data",
   "title": "🗂 文件数据",
   "desc": "文件与数据处理：读写与格式转换、爬取抓取、数据库、编码识别、文档解析与知识库"
  },
  {
   "key": "fun",
   "title": "🎮 娱乐生活",
   "desc": "摸鱼与趣味：小游戏、桌面宠物、表情包、音乐、股票行情与旅行"
  },
  {
   "key": "infra",
   "title": "🛠 基建部署",
   "desc": "运行环境与分发：桌面/移动客户端、远程主机、浏览器桥、沙箱隔离、插件管理、更新与监控"
  },
  {
   "key": "edu",
   "title": "📚 学习研究",
   "desc": "学习与探索：技能包、插件开发指南、文档导航、评测基准与社区 onboarding"
  },
  {
   "key": "other",
   "title": "❓ 其他",
   "desc": "描述缺失或暂未归类的仓库，补充信息后将细分"
  }
 ],
