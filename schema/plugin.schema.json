{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-external/awesome-dsh-plugins/schema/plugin.schema.json",
  "title": "Catalog plugin entry (human fact source)",
  "type": "object",
  "required": ["schema_version", "id", "repository", "curation", "lifecycle"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "description": "Stable GitHub repository id, prefixed github:. Survives rename/transfer.",
      "type": "string",
      "pattern": "^github:[0-9]+$"
    },
    "previous_names": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Prior owner/name after rename or transfer."
    },
    "repository": {
      "type": "object",
      "required": ["full_name", "url"],
      "additionalProperties": false,
      "properties": {
        "full_name": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "entry": { "type": "string" }
      }
    },
    "curation": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["candidate", "listed", "rejected", "removed", "blocked"] },
        "category": { "type": "string" },
        "description_zh": { "type": "string" }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["auto_discovered", "maintainer_pr", "org_member", "verified"] },
        "verified_at": { "type": "string" }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["active", "deprecated", "archived", "deleted", "unknown"] }
      }
    },
    "disclosures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk": { "enum": ["unknown", "low", "medium", "high"] },
        "network": { "type": "boolean" },
        "filesystem": { "enum": ["none", "workspace-read", "workspace-write", "home-read", "arbitrary"] },
        "credentials": { "type": "array", "items": { "type": "string" } },
        "data_handling_url": { "type": "string" }
      }
    },
    "runtime_test": {
      "type": "object",
      "description": "运行级实测结论（scripts/sync-runtime.py 从当日 agent-test 报告同步；P2a 入 schema——24 条存量曾因缺此定义被 additionalProperties:false 全量判违规）。",
      "required": ["status", "reason", "tested_at"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "reason": { "type": "string", "description": "失败原因或通过摘要（截断 200 字符）" },
        "tested_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
