{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://raw.githubusercontent.com/AdamPlatin123/dsh-plugin-radar/main/schema/snapshot.schema.json",
 "title": "radar-snapshot 快照契约（内部口径，不承诺保留窗口）",
 "description": "data/snapshots/*.json 的正式契约。快照是测试引擎的逐轮产物、渲染层的唯一输入；schema 串 radar-snapshot/（版本号在后缀）。基线文件 data/snapshot-baseline.json 只复用 entries 结构，顶层不同。",
 "type": "object",
 "required": ["schema", "run_id", "generated_at", "verdict", "catalog_entries"],
 "additionalProperties": true,
 "properties": {
  "schema": { "type": "string", "pattern": "^radar-snapshot/" },
  "run_id": { "type": "string", "pattern": "^\\d{8}T\\d{6}Z$" },
  "generated_at": { "type": "string" },
  "classifier": { "type": "string" },
  "verdict": {
   "type": "object",
   "required": ["pass", "fail", "total", "cur_image"],
   "additionalProperties": true,
   "properties": {
    "pass": { "type": "integer", "minimum": 0 },
    "fail": { "type": "integer", "minimum": 0 },
    "inc": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "bundle": { "type": "integer", "minimum": 0 },
    "cur_image": { "type": "string", "description": "测试 runner 镜像标签（如 dsh-test-runner:0.1.5-rc.2）" },
    "cur_tested": { "type": "integer", "minimum": 0 },
    "cur_pass": { "type": "integer", "minimum": 0 },
    "version_gate": { "type": "integer", "minimum": 0, "description": "fail 中属于版本门禁的条数（catalog_entries[].fail_kind=version-gate，已计入 fail）" }
   }
  },
  "catalog_entries": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["name", "url", "star", "verdict", "domain", "desc"],
    "additionalProperties": true,
    "properties": {
     "name": { "type": "string", "minLength": 1 },
     "url": { "type": "string", "description": "真实仓库 URL 或 github.com/search?q= 占位" },
     "star": { "type": "integer", "minimum": 0 },
     "verdict": { "enum": ["✅ 运行级可用", "❌ 运行级不兼容", "⚠️ 待定", "⏳ 未测"] },
     "domain": { "type": "string" },
     "desc": { "type": "string" },
     "bundle": { "type": "string" },
     "fail_kind": { "type": "string", "description": "不兼容的细分原因（可选，仅 verdict=❌ 时有意义）。version-gate = 插件声明的 dsh 版本范围不含测试版本，dsh 在安装阶段拒绝，未进入运行" },
     "dsh_requires": { "type": "string", "description": "fail_kind=version-gate 时插件声明的 engines.dsh 范围（可选；由 peerDependencies 精确钉版触发的门禁无此字段）" }
    }
   }
  }
 }
}
